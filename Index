      tick=false;
      var vh=window.innerHeight,top=d.getBoundingClientRect().top+window.scrollY,st=Math.max(0,top-vh),en=top,p=calm?1:(en>st?cl((window.scrollY-st)/(en-st)):1);
      var z=cl(p/.9),e=z*z*(3-2*z);
      var q=cl(p/.7),ey=q*q*(3-2*q);
      s.style.setProperty("--s",(c.s0+c.ds*e).toFixed(3));
      var ph=s.querySelector(".phone"),hl=s.querySelector(".headline"),sp=s.querySelector(".specs"),sh=s.clientHeight||1,nd=hl.scrollHeight||1,ih=ph.offsetHeight*(c.s0+c.ds)/2,ctr;
