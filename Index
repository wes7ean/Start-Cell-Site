  $("filters").innerHTML="";
  cats.forEach(function(c){var b=document.createElement("button");b.textContent=c;b.setAttribute("aria-pressed",c===filter);b.onclick=function(){filter=c;renderFilters();renderGrid()};$("filters").appendChild(b)});
}
function renderGrid(){
  $("grid").innerHTML="";
  PRODUCTS.filter(function(p){return filter==="Todos"||p.cat===filter}).forEach(function(p){
    var d=document.createElement("article");d.className="card";
    d.innerHTML='<div class="thumb">'+p.name.charAt(0)+'</div><div class="info"><h3></h3><p></p><div class="price">'+brl(p.price)+'</div><button class="add">ADICIONAR</button></div>';
    d.querySelector("h3").textContent=p.name;d.querySelector("p").textContent=p.desc;
    d.querySelector(".add").onclick=function(){cart[p.id]=(cart[p.id]||0)+1;renderCart()};
    $("grid").appendChild(d);
  });
}
function renderCart(){
  var n=0,t=0,lines=[];$("items").innerHTML="";
  PRODUCTS.forEach(function(p){var q=cart[p.id];if(!q)return;n+=q;t+=q*p.price;lines.push(q+"x "+p.name+" - "+brl(q*p.price));
    var r=document.createElement("div");r.className="row";
    r.innerHTML='<div><strong></strong><div>'+brl(p.price)+'</div></div><div class="qty"><button aria-label="Diminuir">−</button><span>'+q+'</span><button aria-label="Aumentar">+</button></div>';
    r.querySelector("strong").textContent=p.name;
    var b=r.querySelectorAll("button");
    b[0].onclick=function(){cart[p.id]--;if(!cart[p.id])delete cart[p.id];renderCart()};
    b[1].onclick=function(){cart[p.id]++;renderCart()};
    $("items").appendChild(r)});
  if(!n)$("items").innerHTML='<p class="empty">Seu carrinho está vazio. Adicione um produto para começar.</p>';
  $("count").textContent=n;$("total").textContent=brl(t);
  var a=$("checkout");a.setAttribute("aria-disabled",n?"false":"true");
  a.href=n?"https://wa.me/"+WHATSAPP+"?text="+encodeURIComponent("Olá! Gostaria de fazer este pedido:\n"+lines.join("\n")+"\nTotal: "+brl(t)):"#";
}
$("open-cart").onclick=function(){$("cart").classList.add("open")};
$("close-cart").onclick=function(){$("cart").classList.remove("open")};

