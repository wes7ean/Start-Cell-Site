      s.style.setProperty("--m",cl((p-.1)/.6).toFixed(3));
      s.style.setProperty("--g",(.15+.85*e).toFixed(3));
      var av=ph.getBoundingClientRect().top-s.getBoundingClientRect().top-hl.offsetTop-2;
      hl.style.height=Math.max(0,Math.min(nd,av)).toFixed(1)+"px";
      s.style.setProperty("--t",cl(av/nd).toFixed(3));
      s.style.setProperty("--k1",cl((p-.15)/.35).toFixed(3));
      s.style.setProperty("--k2",cl((p-.3)/.35).toFixed(3));
      s.style.setProperty("--k3",cl((p-.45)/.35).toFixed(3));
    }
    window.addEventListener("scroll",function(){if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});
    window.addEventListener("resize",upd);upd();
  }
